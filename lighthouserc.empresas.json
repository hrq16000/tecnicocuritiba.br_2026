{
  "ci": {
    "collect": {
      "url": ["http://localhost:4173/empresas", "http://localhost:4173/empresa-de-ti-curitiba"],
      "startServerCommand": "npm run preview -- --port 4173",
      "startServerReadyPattern": "preview-built",
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 915,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
        "categories:performance": ["error", { "minScore": 0.75 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "structured-data": "off",
        "document-title": ["error", { "minScore": 1 }],
        "meta-description": ["error", { "minScore": 1 }],
        "html-has-lang": ["error", { "minScore": 1 }],
        "color-contrast": ["error", { "minScore": 1 }],
        "heading-order": ["warn", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 400 }],
        "server-response-time": ["error", { "maxNumericValue": 800 }]
          }
        },
        {
          "matchingUrlPattern": "/empresas$",
          "assertions": {
            "http-status-code": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "robots-txt": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "hreflang": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "/empresa-de-ti-curitiba$",
          "assertions": {
            "categories:seo": ["error", { "minScore": 0.9 }],
            "is-crawlable": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-empresas"
    }
  }
}
