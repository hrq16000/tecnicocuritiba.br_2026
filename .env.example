# --- Modo offline ----------------------------------------------------------
# Com LOCAL_DEV=1 nenhuma chamada a IndexNow, Google Search Console,
# Google Indexing API, Resend, Slack, PagerDuty ou Cloudflare é feita:
# os scripts apenas registram um sucesso simulado no console.
LOCAL_DEV=1

