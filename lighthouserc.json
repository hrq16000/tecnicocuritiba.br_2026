{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/assistencia-tecnica-curitiba",
        "http://localhost:4173/termos-e-condicoes",
        "http://localhost:4173/servicos/manutencao-preventiva-empresas",
        "http://localhost:4173/servicos/backup-para-empresas",
        "http://localhost:4173/servicos/redes-e-wifi",
        "http://localhost:4173/conserto-tv/curitiba",
        "http://localhost:4173/conserto-tv/batel",
        "http://localhost:4173/conserto-celular/sao-jose-dos-pinhais"
      ],
      "startServerCommand": "npm run preview -- --port 4173",
      "startServerReadyPattern": "preview-built",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "interaction-to-next-paint": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1800
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "server-response-time": [
          "error",
          {
            "maxNumericValue": 600
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
